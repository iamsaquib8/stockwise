{
  lib,
  stdenv,
  rustPlatform,
  fetchFromGitHub,
  installShellFiles,
  versionCheckHook,
  nix-update-script,
}:

rustPlatform.buildRustPackage (finalAttrs: {
  pname = "stockwise";
  version = "0.8.1";

  src = fetchFromGitHub {
    owner = "iamsaquib8";
    repo = "stockwise";
    tag = "v${finalAttrs.version}";
    hash = "sha256-I4DDghl4q/Pi8MscU6HB9j7Yjz6A7GWFGXyyFwXI288=";
  };

  cargoHash = "sha256-lcX/tUlKtUNg+S3KVyydjUps8U4gx28ej2U5FPzP6K0=";

  nativeBuildInputs = [ installShellFiles ];

  # Man pages and completions are generated by the binary from its CLI
  # definition.
  postInstall = lib.optionalString (stdenv.buildPlatform.canExecute stdenv.hostPlatform) ''
    $out/bin/stockwise man --dir man
    installManPage man/*.1
    installShellCompletion --cmd stockwise \
      --bash <($out/bin/stockwise completions bash) \
      --fish <($out/bin/stockwise completions fish) \
      --zsh <($out/bin/stockwise completions zsh)
  '';

  nativeInstallCheckInputs = [ versionCheckHook ];
  doInstallCheck = true;

  passthru.updateScript = nix-update-script { };

  meta = {
    description = "Stock market toolkit for the terminal: NSE/BSE and US stocks, funds, F&O, backtests and portfolio";
    homepage = "https://github.com/iamsaquib8/stockwise";
    changelog = "https://github.com/iamsaquib8/stockwise/blob/v${finalAttrs.version}/CHANGELOG.md";
    license = lib.licenses.mit;
    maintainers = with lib.maintainers; [ ];
    mainProgram = "stockwise";
  };
})
